# HabitFlow root environment variables
# Copy to apps/api/.env for local API development.

NODE_ENV=development
PORT=4000

# PostgreSQL (see docker-compose.yml)
DATABASE_URL=postgresql://habitflow:habitflow@localhost:5432/habitflow

# Redis (cache / queue / rate-limit)
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-in-prod-32-chars-min
JWT_REFRESH_SECRET=change-me-too-32-chars-min

# CORS
CORS_ORIGIN=http://localhost:3000

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email (SMTP). Leave EMAIL_HOST empty for console-only mail in development
# (verification/reset links are printed to the API logs).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=no-reply@habitflow.app

# Resend / SES (alternative to SMTP)
EMAIL_API_KEY=

# Public web app origin (used to build email links)
WEB_APP_URL=http://localhost:3000
