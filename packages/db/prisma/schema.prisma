generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DELETING
}

enum PlanCode {
  FREE
  PRO_MONTHLY
  PRO_ANNUAL
  FAMILY_MONTHLY
  FAMILY_ANNUAL
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  UNPAID
}

enum HabitType {
  POSITIVE
  NEGATIVE
}

enum HabitDifficulty {
  EASY
  MEDIUM
  HARD
}

enum TargetPeriod {
  DAY
  WEEK
  MONTH
  INTERVAL
}

enum GoalStatus {
  ACTIVE
  AT_RISK
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum WellnessMetricType {
  SLEEP
  WATER
  EXERCISE
  MOOD
  ENERGY
  STRESS
  MEDITATION
  READING
  SCREEN_TIME
}

enum JournalEntryType {
  DAILY
  GRATITUDE
  REFLECTION
  FREE
}

enum EventType {
  HABIT_COMPLETED
  HABIT_SKIPPED
  GOAL_PROGRESS
  TASK_DONE
  WELLNESS_LOGGED
  JOURNAL_CREATED
  AI_PLAN_ACCEPTED
  XP_EARNED
  BADGE_UNLOCKED
  CHALLENGE_PROGRESS
  FOCUS_SESSION
  POMODORO_COMPLETED
}

enum ScoreType {
  HABIT
  GROWTH
  FOCUS
  LIFESTYLE
}

enum ScoreWindow {
  DAY
  WEEK
}

enum AiRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum AiMemoryKind {
  FACT
  PREFERENCE
  PATTERN
  GOAL_CONTEXT
}

enum ChallengeKind {
  PERSONAL
  GROUP
}

enum NotificationType {
  REMINDER
  STREAK_RISK
  PLAN_READY
  AI_NUDGE
  BURNOUT_ALERT
  COMMUNITY
  BILLING
  SYSTEM
}

enum IntegrationProvider {
  GOOGLE_CALENDAR
  APPLE_CALENDAR
  OUTLOOK_CALENDAR
  APPLE_HEALTH
  GOOGLE_FIT
  FITBIT
  GARMIN
  SAMSUNG_HEALTH
  WEBHOOK
}

enum IntegrationStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum Role {
  USER
  PRO
  FAMILY_OWNER
  MODERATOR
  ADMIN
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum FeedPostType {
  ACHIEVEMENT
  MILESTONE
  SHARED_PROGRESS
  GENERAL
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum SyncStatus {
  PENDING
  PROCESSED
  FAILED
}

// ---------- Identity & Access ----------

model User {
  id                    String      @id @default(uuid())
  email                 String      @unique
  passwordHash          String?
  displayName           String
  avatarUrl             String?
  timezone              String      @default("UTC")
  locale                String      @default("en")
  tzOffsetMin           Int         @default(0)
  units                 String      @default("metric")
  theme                 String      @default("system")
  status                UserStatus  @default(PENDING_VERIFICATION)
  twoFactorEnabled      Boolean     @default(false)
  twoFactorSecretEnc    String?
  backupCodesEnc        String?
  ageVerifiedAt         DateTime?
  lastLoginAt           DateTime?
  plan                  PlanCode    @default(FREE)
  onboardedAt           DateTime?
  deletedAt             DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  authProviders         AuthProvider[]
  sessions              Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  habits                Habit[]
  habitCategories       HabitCategory[]
  goals                 Goal[]
  tasks                 Task[]
  timeBlocks            TimeBlock[]
  wellnessMetrics       WellnessMetric[]
  journalEntries        JournalEntry[]
  events                Event[]
  scoreSnapshots        ScoreSnapshot[]
  aiConversations       AiConversation[]
  aiMessages            AiMessage[]
  aiMemories            AiMemory[]
  notifications         Notification[]
  badges                BadgeAward[]
  userLevels            UserLevel?
  subscriptions         Subscription[]
  integrations          IntegrationConnection[]

  @@index([plan])
}

model AuthProvider {
  id         String   @id @default(uuid())
  userId     String
  provider   String
  providerId String
  email      String?
  meta       Json?
  linkedAt   DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  deviceId         String?
  ip               String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Billing ----------

model Subscription {
  id                      String             @id @default(uuid())
  userId                  String
  planCode                PlanCode
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  status                  SubscriptionStatus @default(TRIALING)
  trialEndsAt             DateTime?
  currentPeriodEnd        DateTime?
  cancelAt                DateTime?
  familyMembers           Json?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stripeSubscriptionId])
}

// ---------- Habits ----------

model HabitCategory {
  id        String   @id @default(uuid())
  userId    String
  name      String
  icon      String?
  color     String?
  sort      Int      @default(0)
  isSystem  Boolean  @default(false)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  habits    Habit[]

  @@unique([userId, name])
  @@index([userId])
}

model Habit {
  id                   String          @id @default(uuid())
  userId               String
  categoryId           String?
  templateId           String?
  name                 String
  description          String?
  icon                 String?
  color                String?
  type                 HabitType       @default(POSITIVE)
  difficulty           HabitDifficulty @default(MEDIUM)
  targetQty            Int             @default(1)
  targetPeriod         TargetPeriod    @default(DAY)
  intervalDays         Int?
  scheduleDays         Int[]
  remindAtMin          Int?
  reminderEnabled      Boolean         @default(false)
  streakFreezeEnabled  Boolean         @default(true)
  source               String          @default("USER")
  archivedAt           DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category             HabitCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  completions          HabitCompletion[]
  streak               HabitStreak?
  timeBlocks           TimeBlock[]
  goalLinks            GoalLink[]

  @@index([userId, archivedAt])
  @@index([categoryId])
}

model HabitCompletion {
  id              String   @id @default(uuid())
  userId          String
  habitId         String
  localId         String
  occurredAt      DateTime
  qty             Int      @default(1)
  note            String?
  source          String   @default("APP")
  idempotencyKey  String   @unique
  syncedAt        DateTime?
  createdAt       DateTime @default(now())

  habit           Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([userId, localId])
  @@index([userId, occurredAt])
  @@index([habitId, occurredAt])
}

model HabitStreak {
  id              String   @id @default(uuid())
  userId          String
  habitId         String   @unique
  currentStreak   Int      @default(0)
  longestStreak   Int      @default(0)
  frozenCount     Int      @default(0)
  lastCompletedOn DateTime?
  streakStartDate DateTime?
  updatedAt       DateTime @updatedAt

  habit           Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- Goals ----------

model Goal {
  id            String         @id @default(uuid())
  userId        String
  title         String
  description   String?
  goalType      String?
  startDate     DateTime?
  endDate       DateTime?
  targetMetric  String?
  targetValue   Float?
  currentValue  Float          @default(0)
  status        GoalStatus     @default(ACTIVE)
  smart         Json?
  archivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones    GoalMilestone[]
  goalLinks     GoalLink[]

  @@index([userId])
}

model GoalMilestone {
  id          String    @id @default(uuid())
  goalId      String
  title       String
  dueDate     DateTime?
  weight      Float     @default(1)
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model GoalLink {
  id         String   @id @default(uuid())
  goalId     String
  habitId    String?
  taskId     String?
  weight     Float    @default(1)
  createdAt  DateTime @default(now())

  goal       Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  habit      Habit?   @relation(fields: [habitId], references: [id], onDelete: Cascade)
  task       Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@index([habitId])
  @@index([taskId])
}

// ---------- Productivity ----------

model Task {
  id             String     @id @default(uuid())
  userId         String
  parentId       String?
  title          String
  notes          String?
  dueDate        DateTime?
  dueTzOffsetMin Int?
  priority       Int        @default(0)
  status         TaskStatus @default(TODO)
  estimatedMin   Int?
  completedAt    DateTime?
  recurringRule  Json?
  tags           String[]
  order          Int        @default(0)
  archivedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks       Task[]     @relation("TaskSubtasks")
  parent         Task?      @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  timeBlocks     TimeBlock[]
  goalLinks      GoalLink[]

  @@index([userId, status])
  @@index([dueDate])
}

model TimeBlock {
  id          String    @id @default(uuid())
  userId      String
  habitId     String?
  taskId      String?
  title       String
  startsAt    DateTime
  endsAt      DateTime
  kind        String    @default("FOCUS")
  aiSuggested Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit       Habit?    @relation(fields: [habitId], references: [id], onDelete: SetNull)
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startsAt])
}

// ---------- Wellness ----------

model WellnessMetric {
  id         String             @id @default(uuid())
  userId     String
  metric     WellnessMetricType
  occurredAt DateTime
  value      Float
  unit       String?
  extra      Json?
  source     String             @default("APP")
  externalId String?
  createdAt  DateTime           @default(now())

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, metric, externalId])
  @@index([userId, metric, occurredAt])
}

// ---------- Journaling ----------

model JournalEntry {
  id          String           @id @default(uuid())
  userId      String
  entryType   JournalEntryType @default(FREE)
  title       String?
  body        String?
  mood        Int?
  tags        String[]
  attachmentUrl String?
  privacy     String           @default("PRIVATE")
  entryDate   DateTime         @default(now())
  aiSummary   Json?
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entryDate])
}

// ---------- Events & Analytics ----------

model Event {
  id             String    @id @default(uuid())
  userId         String
  streamId       String?
  type           EventType
  entityType     String?
  entityId       String?
  occurredAt     DateTime
  tzOffsetMin    Int       @default(0)
  payload        Json?
  idempotencyKey String    @unique
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([type, occurredAt])
}

model ScoreSnapshot {
  id          String      @id @default(uuid())
  userId      String
  window      ScoreWindow
  scoreType   ScoreType
  value       Float
  components  Json?
  periodStart DateTime
  computedAt  DateTime    @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scoreType, window, periodStart])
  @@index([userId, computedAt])
}

// ---------- Gamification ----------

model UserLevel {
  id         String   @id @default(uuid())
  userId     String   @unique
  level      Int      @default(1)
  xp         Int      @default(0)
  totalXp    Int      @default(0)
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id        String   @id @default(uuid())
  code      String   @unique
  title     String
  description String?
  icon      String?
  rarity    String   @default("COMMON")
  criteria  Json?
  createdAt DateTime @default(now())

  awards    BadgeAward[]
}

model BadgeAward {
  id         String   @id @default(uuid())
  userId     String
  badgeId    String
  awardedAt  DateTime @default(now())
  shared     Boolean  @default(false)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge      Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

// ---------- AI ----------

model AiConversation {
  id         String       @id @default(uuid())
  userId     String
  title      String?
  pinned     Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages   AiMessage[]
}

model AiMessage {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  role           AiRole
  content        String
  toolCalls      Json?
  toolResults    Json?
  model          String?
  latencyMs      Int?
  tokens         Int?
  createdAt      DateTime     @default(now())

  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId])
}

model AiMemory {
  id             String        @id @default(uuid())
  userId         String
  kind           AiMemoryKind
  content        String
  source         Json?
  importance     Float         @default(0.5)
  embedding      Unsupported("vector(1536)")?
  lastAccessedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@index([userId, importance])
}

// ---------- Notifications & Platform ----------

model Notification {
  id            String           @id @default(uuid())
  userId        String
  type          NotificationType
  title         String
  body          String?
  data          Json?
  readAt        DateTime?
  scheduledFor  DateTime?
  sentAt        DateTime?
  createdAt     DateTime         @default(now())

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([scheduledFor])
}

model IntegrationConnection {
  id         String             @id @default(uuid())
  userId     String
  provider   IntegrationProvider
  tokensEnc  Json?
  scopes     String[]
  status     IntegrationStatus  @default(CONNECTED)
  lastSyncAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model FeatureFlag {
  id        String    @id @default(uuid())
  key       String    @unique
  enabled   Boolean   @default(false)
  rollout   Json?
  updatedAt DateTime  @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  ip         String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
}
